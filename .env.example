# KisanClaim MCP Configuration

# Force deterministic sample data for offline hackathon demos (true/false)
DEMO_MODE=true

# Optional LLM API Key (works completely offline without any key via guided MCP state machine)
LLM_API_KEY=

# Optional ElevenLabs TTS API Key (defaults to browser SpeechSynthesis in kn-IN and en-IN if empty)
ELEVENLABS_API_KEY=

# Scale of Finance per acre in INR for PMFBY indicative payout estimate (Default: 10000)
SCALE_OF_FINANCE_PER_ACRE=10000

# SQLite Database connection URL or path
DATABASE_URL=sqlite:///./backend/kisanclaim.db
